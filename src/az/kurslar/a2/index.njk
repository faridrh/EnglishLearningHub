  </div>
</section>

<section class="grammar-topics">
  <div class="container">
    <h2 class="section-title">A2 Dərsləri</h2>
    <div class="topics-grid">
      {% for lesson in a2Lessons %}
      <div class="topic-card">
        <h3 class="topic-title">Dərs {{ lesson.number }}: {{ lesson.indexTitle }}</h3>
        <p class="topic-description">{{ lesson.indexDescription }}</p>
        <a href="/courses/a2/lesson-{{ lesson.number }}/" class="topic-link">Dərsi Aç</a>
      </div>
      {% endfor %}
    </div>

    <div class="section-footer">
      {% for lesson in a2Lessons %}
      <a href="/courses/a2/lesson-{{ lesson.number }}/" class="button{% if loop.index % 2 == 0 %} button-secondary{% endif %}">Dərs {{ lesson.number }}: {{ lesson.title }}</a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <h2 class="cta-title">Pulsuz İngilis Dili Dərsləri</h2>
